# ── App ───────────────────────────────────────────────
APP_SECRET_KEY=replace-with-a-strong-random-secret
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_MINUTES=15

# ── Active Directory (LDAP) ───────────────────────────
AD_SERVER=ldap://your-dc.company.com
AD_DOMAIN=company.com
AD_BIND_USER=CN=svc-otp,OU=ServiceAccounts,DC=company,DC=com
AD_BIND_PASSWORD=your-service-account-password
AD_BASE_DN=DC=company,DC=com

# ── Microsoft Graph API (Azure AD / hybrid) ───────────
# Leave blank to use LDAP instead
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Twilio (SMS + WhatsApp) ───────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
WHATSAPP_FROM=whatsapp:+14155238886

# ── SendGrid (Email) ──────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@company.com
EMAIL_FROM_NAME=IT Helpdesk

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ad_unlock.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/ad_unlock

# ── Risk Engine ───────────────────────────────────────
ENABLE_IP_CHECK=true
HIGH_RISK_UNLOCK_REQUIRES_MANAGER=true
